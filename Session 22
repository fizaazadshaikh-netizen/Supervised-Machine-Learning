from imblearn.over_sampling import SMOTE
from sklearn.model_selection import GridSearchCV
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import roc_auc_score


# Check class distribution
print("Original Class Distribution:")
print(y_train.value_counts())


# Apply SMOTE only to training data
smote = SMOTE(
    random_state=42
)

X_train_smote, y_train_smote = smote.fit_resample(
    X_train,
    y_train
)


print("\nClass Distribution After SMOTE:")
print(
    pd.Series(y_train_smote).value_counts()
)


# Create Random Forest
rf = RandomForestClassifier(
    random_state=42
)


# Parameter grid
param_grid = {

    "n_estimators": [
        50,
        100,
        200
    ],

    "max_depth": [
        None,
        5,
        10
    ]
}


# GridSearchCV
grid_search = GridSearchCV(
    rf,
    param_grid,
    cv=3,
    scoring="roc_auc",
    n_jobs=-1
)


# Train model
grid_search.fit(
    X_train_smote,
    y_train_smote
)


# Best parameters
print("\nBest Parameters:")
print(
    grid_search.best_params_
)


# Best cross-validation score
print(
    "Best CV ROC-AUC:",
    grid_search.best_score_
)


# Evaluate on original test data
best_model = grid_search.best_estimator_

test_prob = best_model.predict_proba(
    X_test
)[:, 1]

test_auc = roc_auc_score(
    y_test,
    test_prob
)

print(
    "Test ROC-AUC:",
    test_auc
)


EXPLANATION:

SMOTE balances the training data by creating synthetic examples of the minority class. GridSearchCV then searches for the best combination of n_estimators and max_depth. The final model is evaluated on the original test set so that the test results remain realistic.


